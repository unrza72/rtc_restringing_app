// Schema for the RTC restringing app.
//
// The auth models (User/Session/Account/Verification) are owned by better-auth —
// regenerate them with `pnpm dlx @better-auth/cli generate` after changing
// src/lib/auth.ts, and re-apply the app relations marked below by hand.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// better-auth
// ---------------------------------------------------------------------------

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // "member" | "operator" | "controller" | "admin", comma-separated for multiple (admin plugin)
  role            String?
  banned          Boolean?  @default(false)
  banReason       String?
  banExpires      DateTime?
  // PENDING | APPROVED | REJECTED — an admin must approve before the app opens up
  status          String?   @default("PENDING")
  approvedAt      DateTime?
  approvedById    String?
  // "en" | "de" — null until recorded by a login/signup or an explicit switch
  locale          String?
  // The invite token this account was created with. Not the source of truth
  // (Invite.usedById is) — just a denormalized copy so better-auth's own
  // signUp.email() call can carry the token through, typed, with no extra
  // server round trip. See src/lib/auth.ts's validateUserInfo.
  inviteToken     String?
  // When the member finished (or dismissed) the welcome tour shown on their
  // first visit. null = not seen yet, so the tour opens on its own.
  onboardedAt     DateTime?
  sessions        Session[]
  accounts        Account[]

  // app relations
  rackets       Racket[]
  requests      StringingRequest[] @relation("requester")
  stringingJobs StringingRequest[] @relation("operator")
  paidRequests  StringingRequest[] @relation("paidBy")
  events        RequestEvent[]
  labourEarned  Reimbursement[]    @relation("labourReimbursement")
  reimbursementsRecorded Reimbursement[] @relation("reimbursementRecordedBy")
  invitesCreated Invite[] @relation("inviteCreatedBy")
  invitesUsed    Invite[] @relation("inviteUsedBy")
  trainingPlans  TrainingPlan[] @relation("trainingPlanCreatedBy")
  auditActions   MemberAuditEntry[] @relation("auditActor")
  auditEntries   MemberAuditEntry[] @relation("auditTarget")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  // No `issuer` column: better-auth added one in 1.7.0–1.7.2 and removed it
  // again in 1.7.3. Left in place it is required but never written, so every
  // signup fails. See the 1.7 upgrade guide.
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// app
// ---------------------------------------------------------------------------

model Racket {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  label         String
  brand         String?
  model         String?
  headSizeCm2   Int?
  stringPattern String?
  gripSize      String?
  /// The member's usual tension in kg, prefilled on new requests.
  tensionMain   Float?
  tensionCross  Float?
  notes         String?
  archived      Boolean  @default(false)
  /// The stand-in created when a member requests a restring before adding any
  /// racket of their own. Never listed under "my rackets"; one per member.
  hidden        Boolean  @default(false)
  /// Soft delete: the member no longer sees the racket anywhere, but finished
  /// jobs keep pointing at it and still show its label.
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requests StringingRequest[]

  @@index([ownerId])
}

/// Strings the club stocks. Deactivated rather than deleted so finished jobs
/// keep showing what was strung.
model ClubString {
  id         String   @id @default(cuid())
  name       String
  gauge      String?
  priceCents Int?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  requests StringingRequest[]

  @@index([active, sortOrder])
}

model StringingRequest {
  id          String @id @default(cuid())
  racketId    String
  racket      Racket @relation(fields: [racketId], references: [id])
  requesterId String
  requester   User   @relation("requester", fields: [requesterId], references: [id])

  /// REQUESTED | ACCEPTED | DONE | COLLECTED | CANCELLED
  status String @default("REQUESTED")

  /// MEMBER (own string, see ownStringName) | CLUB (see clubStringId)
  stringSource  String
  clubStringId  String?
  clubString    ClubString? @relation(fields: [clubStringId], references: [id])
  /// For CLUB jobs whose catalogue string was deleted later: that string's
  /// name, kept so old jobs still say what was strung.
  ownStringName String?
  /// Optional: null leaves the tension to the stringer.
  tensionMain   Float?
  tensionCross  Float?
  neededBy      DateTime?
  memberNotes   String?
  /// Number on the carabiner the member clips to the racket in the clubhouse
  /// (RACKET_TOKENS_ENABLED). Kept after pickup, as a record.
  tokenNumber   Int?
  /// The same number, but only while the request is open — cleared on
  /// COLLECTED or CANCELLED. Unique, so the database itself refuses a second
  /// open request on a carabiner that is already in use, even under a race.
  activeToken   Int?     @unique

  operatorId     String?
  operator       User?     @relation("operator", fields: [operatorId], references: [id])
  acceptedAt     DateTime?
  completedAt    DateTime?
  collectedAt    DateTime?
  operatorNotes  String?
  usedStringName String?
  usedTensionMain  Float?
  usedTensionCross Float?
  /// The price is three parts, all stamped when the job is marked done so
  /// later price changes leave finished jobs alone (SPEC.md §5a):
  /// string cost — the catalogue price of the club string, null for the
  /// member's own string;
  stringPriceCents Int?
  /// labour — the club's flat rate, reimbursed to the stringer;
  labourPriceCents Int?
  /// rake — the club's flat cut for machine upkeep and hosting, kept by the
  /// club. Not labour, so not in stringer payouts.
  rakeCents Int?

  /// Set by a controller (or admin) once the member has paid; null = unpaid.
  paidAt   DateTime?
  paidById String?
  paidBy   User?     @relation("paidBy", fields: [paidById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events RequestEvent[]

  @@index([status, createdAt])
  @@index([requesterId])
  @@index([operatorId])
  @@index([racketId])
}

/// Club-wide settings an admin can change. One row, id 1; read with the
/// defaults below when it does not exist yet.
model ClubSettings {
  id         Int      @id @default(1)
  /// Carabiners available for tagging rackets, numbered 1..tokenCount.
  tokenCount Int      @default(20)
  /// Flat labour fee per racket in cents, the same for every stringer. Copied
  /// onto each job when it is marked done; null = not set yet.
  labourPriceCents Int?
  /// The club's cut per racket in cents, on every job whatever the string —
  /// machine maintenance and app hosting. null = not set yet.
  rakeCents Int?
  /// The club's bank account for the payment QR code (SPEC.md §16). Without
  /// recipient and IBAN, no payment details are shown anywhere.
  paymentRecipient String?
  /// Stored uppercase, without spaces.
  paymentIban      String?
  /// Optional inside SEPA.
  paymentBic       String?
  updatedAt  DateTime @updatedAt
}

model RequestEvent {
  id         String           @id @default(cuid())
  requestId  String
  request    StringingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User             @relation(fields: [actorId], references: [id])
  fromStatus String?
  toStatus   String
  note       String?
  createdAt  DateTime         @default(now())

  @@index([requestId, createdAt])
}

/// A payout to a stringer for accumulated labour: outstanding balance =
/// SUM(StringingRequest.labourPriceCents where paidAt is set and operatorId
/// matches) minus SUM(Reimbursement.amountCents for that operator). Append-only
/// ledger — a mistaken entry is corrected with a new entry, not edited in place.
model Reimbursement {
  id          String   @id @default(cuid())
  operatorId  String
  operator    User     @relation("labourReimbursement", fields: [operatorId], references: [id])
  amountCents Int
  note        String?
  createdById String
  createdBy   User     @relation("reimbursementRecordedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([operatorId, createdAt])
}

/// A shareable, single-use link that gates account creation — /signup refuses
/// to create anyone without a valid, unexpired, unused, unrevoked one. The
/// club's actual gate lives in src/lib/auth.ts's validateUserInfo, which
/// atomically claims a row here (sets usedAt) before better-auth is allowed to
/// create the user; databaseHooks.user.create.after then stamps usedById once
/// the new user's id is known.
model Invite {
  id          String    @id @default(cuid())
  token       String    @unique
  createdById String
  createdBy   User      @relation("inviteCreatedBy", fields: [createdById], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  usedBy      User?     @relation("inviteUsedBy", fields: [usedById], references: [id])
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdById, createdAt])
}

/// Who approved, rejected, re-roled or deleted whom, and when. Append-only:
/// written in the same transaction as the change it records, never edited.
/// Names and emails are copied in, and both links are cleared rather than the
/// row deleted, so an entry still reads correctly after either account is gone.
model MemberAuditEntry {
  id          String   @id @default(cuid())
  /// APPROVED | REJECTED | ROLES_CHANGED | DELETED | ADMIN_SET
  action      String
  /// null = the command line (`pnpm admin:set`), or an account since deleted.
  actorId     String?
  actor       User?    @relation("auditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName   String?
  targetId    String?
  target      User?    @relation("auditTarget", fields: [targetId], references: [id], onDelete: SetNull)
  targetName  String
  targetEmail String
  /// Status (PENDING | APPROVED | REJECTED) or the stored role list, before
  /// and after. Both null for DELETED.
  fromValue   String?
  toValue     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetId, createdAt])
}

// ---------------------------------------------------------------------------
// training planner
// ---------------------------------------------------------------------------

/// Somebody in the training programme. Deliberately standalone rather than a
/// User relation: juniors have no club login, and a coach types the roster in.
model TrainingPerson {
  id       String  @id @default(cuid())
  name     String
  /// TRAINEE | TRAINER
  kind     String
  /// RED | ORANGE | GREEN | YELLOW. Required for trainees, unused for trainers.
  ball     String?
  /// 0 (beginner) … 5 (strongest) within that ball. Trainees only.
  strength Float?
  notes    String?
  /// Kept out of new plans without losing the ones already solved.
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availability TrainingAvailability[]
  ledGroups    TrainingGroup[]        @relation("groupTrainer")
  memberships  TrainingGroupMember[]
  unplacedIn   TrainingPlanUnplaced[]

  @@index([kind, archived, name])
}

/// One recurring window per week, e.g. Monday 17:00–19:00. Minutes from
/// midnight rather than DateTime, because nothing here is a calendar date.
model TrainingAvailability {
  id       String         @id @default(cuid())
  personId String
  person   TrainingPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// 0 = Monday … 6 = Sunday
  weekday  Int
  startMin Int
  endMin   Int

  createdAt DateTime @default(now())

  @@index([personId, weekday, startMin])
}

/// One run of the solver, stored with the knobs it ran on so two runs can be
/// compared. Immutable: re-solving writes a new plan rather than editing one.
model TrainingPlan {
  id          String @id @default(cuid())
  name        String
  createdById String
  createdBy   User   @relation("trainingPlanCreatedBy", fields: [createdById], references: [id])

  // the inputs, copied in so a plan still explains itself after the knobs move
  minGroupSize    Int
  maxGroupSize    Int
  strengthSpread  Float
  sessionMinutes  Int
  slotStepMinutes Int
  courtCount      Int

  createdAt DateTime @default(now())

  groups   TrainingGroup[]
  unplaced TrainingPlanUnplaced[]

  @@index([createdAt])
}

model TrainingGroup {
  id        String         @id @default(cuid())
  planId    String
  plan      TrainingPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   TrainingPerson @relation("groupTrainer", fields: [trainerId], references: [id])
  weekday   Int
  startMin  Int
  endMin    Int
  ball      String
  court     Int

  members TrainingGroupMember[]

  @@index([planId, weekday, startMin])
}

model TrainingGroupMember {
  id       String         @id @default(cuid())
  groupId  String
  group    TrainingGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  personId String
  person   TrainingPerson @relation(fields: [personId], references: [id])

  @@unique([groupId, personId])
  @@index([personId])
}

/// Who the solver could not place, and why — the half of the result a coach
/// actually has to act on.
model TrainingPlanUnplaced {
  id       String         @id @default(cuid())
  planId   String
  plan     TrainingPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  personId String
  person   TrainingPerson @relation(fields: [personId], references: [id])
  /// NO_AVAILABILITY | NO_TRAINER_OVERLAP | NO_COMPATIBLE_GROUP
  reason   String

  @@unique([planId, personId])
  @@index([personId])
}
